# Paddle Payment Keys (Production/Live Mode)
# Get from: https://vendors.paddle.com/authentication
PADDLE_LIVE=1
PADDLE_ENV=production
PADDLE_API_KEY=your_production_paddle_api_key_here
PADDLE_WEBHOOK_SECRET=your_production_paddle_webhook_secret_here

# Paddle Plan Price IDs (from Paddle production dashboard)
PADDLE_STARTER_PRICE_ID=pri_...
PADDLE_PRO_PRICE_ID=pri_...
PADDLE_ENTERPRISE_PRICE_ID=pri_...

NEXT_PUBLIC_PADDLE_CLIENT_TOKEN=your_production_client_token_here
NEXT_PUBLIC_PADDLE_ENV=live

TURSO_API_KEY=your_turso_api_key_here
TURSO_DATABASE_URL=libsql://your-database-url.turso.io

# n8n Workflow Automation
N8N_BASE_URL=https://agent-ia.innotechlabssas.lat
N8N_API_KEY=your_n8n_api_key_here
N8N_WEBHOOK_SECRET=your_n8n_webhook_secret_here

# Evolution API (WhatsApp)
# Deploy on EasyPanel: https://easypanel.io
# Docker image: atendai/evolution-api:latest
# Domain: api-message.innotechlabssas.lat (configured in Cloudflare)
EVOLUTION_API_URL=https://api-message.innotechlabssas.lat
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=localplug-main
CONFIG_SESSION_PHONE_VERSION=2.3000.1028355510
EVOLUTION_WEBHOOK_SECRET=your_evolution_webhook_secret_here

# OpenAI (primary AI provider for n8n and app fallback)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-4o

# Ollama (local AI fallback)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

# Upstash Redis (distributed rate limiting — optional, falls back to in-memory)
# Get from: https://console.upstash.com/redis
# UPSTASH_REDIS_REST_URL=https://your-upstash-url.upstash.io
# UPSTASH_REDIS_REST_TOKEN=your_upstash_token

# Cron job secret for /api/cron/process-queue (Vercel cron calls include x-vercel-cron header;
# set this only if you need to trigger queue processing manually via URL)
# CRON_SECRET=your_random_secret

# Queue worker token for POST /api/admin/queue (manual queue processing)
QUEUE_WORKER_TOKEN=your_queue_worker_token

# DB connection pool (default: 16)
# DB_CONCURRENCY=16

# Log level: debug | info | warn | error (default: info)
# LOG_LEVEL=info

# Site URL (CORS, public links)
NEXT_PUBLIC_SITE_URL=https://localplug.vercel.app

# WhatsApp Business Number (for wa.me link in chat widget)
NEXT_PUBLIC_WHATSAPP_NUMBER=573128386640
