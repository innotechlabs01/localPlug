# Stripe Test Mode Keys
# Get from: https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_publishable_key_here
STRIPE_SECRET_KEY=sk_test_your_secret_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_secret_here

TURSO_API_KEY=your_turso_api_key_here
TURSO_DATABASE_URL=libsql://your-database-url.turso.io

# n8n Workflow Automation
N8N_BASE_URL=https://agent-ia.innotechlabssas.lat
N8N_API_KEY=your_n8n_api_key_here

# Evolution API (WhatsApp)
# Deploy on EasyPanel: https://easypanel.io
# Docker image: atendai/evolution-api:latest
# Domain: api-message.innotechlabssas.lat (configured in Cloudflare)
EVOLUTION_API_URL=https://api-message.innotechlabssas.lat
EVOLUTION_API_KEY=your_evolution_api_key_here
EVOLUTION_INSTANCE_NAME=localplug-main

# OpenAI (for AI Agent in n8n)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o
