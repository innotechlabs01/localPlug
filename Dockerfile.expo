# Expo Go development container
# Used by docker-compose.dev.yml for tunnel-based development
FROM node:20-alpine

RUN corepack enable && corepack prepare pnpm@10.30.1 --activate

WORKDIR /app

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

EXPOSE 8099

# Listen on all interfaces so tunnel container can reach it via Docker network
CMD ["npx", "expo", "start", "--port", "8099", "--host", "0.0.0.0"]
