{
  "name": "premium-andean-hospitality",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "preinstall": "npx only-allow pnpm",
    "build": "pnpm install --force && next build",
    "start": "next start",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "prettier": "prettier --write .",
    "prettier:check": "prettier --check .",
    "db:migrate": "npx tsx scripts/migrate.ts",
    "db:clear-drivers": "npx tsx scripts/migrate.ts clear-drivers",
    "db:reset-orders": "npx tsx scripts/migrate.ts reset-orders",
    "db:status": "npx tsx scripts/migrate.ts status",
    "setup-admin": "npx tsx scripts/setup-admin.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "unrs-resolver"
    ]
  },
  "dependencies": {
    "@clerk/nextjs": "^7.4.1",
    "@libsql/client": "^0.17.3",
    "@stripe/react-stripe-js": "^6.3.0",
    "@stripe/stripe-js": "^9.5.0",
    "next": "^15.5.18",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "stripe": "^22.1.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "^16.2.6",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.8.0",
    "@types/react": "^18.3.29",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.5.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.4.0",
    "eslint-config-next": "^16.2.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "jsdom": "^29.1.1",
    "postcss": "^8.5.14",
    "prettier": "^3.8.3",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.8.3",
    "vitest": "^4.1.6"
  }
}
