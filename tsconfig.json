{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "baseUrl": ".",
    "plugins": [
      {
        "name": "next"
      }
    ],
"paths": {
      "@/*": [
        "./*"
      ],
      "@lp/shared": [
        "packages/shared/src"
      ],
      "@lp/config": [
        "packages/config/src"
      ],
      "@lp/auth": [
        "packages/auth/src"
      ],
      "@lp/validation": [
        "packages/validation/src"
      ],
      "@lp/types": [
        "packages/types/src"
      ],
      "@lp/db": [
        "packages/db/src"
      ],
      "@lp/db/*": [
        "packages/db/src/*"
      ],
      "@lp/events": [
        "packages/events/src"
      ],
      "@lp/domains": [
        "packages/domains/_services/src"
      ],
      "@lp/domains/*": [
        "packages/domains/_services/src/*"
      ],
      "@lp/communication": [
        "packages/communication/src"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    "admin-page-backups",
    "apps"
  ]
}
